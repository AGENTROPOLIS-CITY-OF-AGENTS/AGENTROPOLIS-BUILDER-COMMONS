{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/spec/builder-commons/project-manifest.schema.json",
  "title": "Builder Commons Project Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "name", "status", "repositories", "capabilities"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "project_id": { "type": "string", "minLength": 3 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["idea", "spawned", "incubating", "building", "verifying", "shipped", "maintaining", "graduated", "archived"]
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "role", "locator"],
        "properties": {
          "provider": { "type": "string" },
          "role": { "type": "string", "enum": ["canonical", "mirror", "dependency", "artifact"] },
          "locator": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "agents": { "type": "boolean" },
        "screen_share": { "type": "boolean" },
        "broadcast": { "type": "boolean" },
        "spatial": { "type": "boolean" },
        "sandbox": { "type": "boolean" },
        "compute": { "type": "boolean" },
        "economic_rails": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "integrations": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "economic_policy_ref": { "type": ["string", "null"] },
    "governance_policy_ref": { "type": ["string", "null"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}