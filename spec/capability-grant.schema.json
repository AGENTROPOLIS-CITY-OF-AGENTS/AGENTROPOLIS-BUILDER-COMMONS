{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/spec/builder-commons/capability-grant.schema.json",
  "title": "Builder Commons Capability Grant",
  "type": "object",
  "required": ["schema_version", "grant_id", "subject_ref", "resource_ref", "permissions", "issued_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "grant_id": { "type": "string" },
    "subject_ref": { "type": "string" },
    "resource_ref": { "type": "string" },
    "mandate_ref": { "type": ["string", "null"] },
    "permissions": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "constraints": {
      "type": "object",
      "properties": {
        "max_cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] },
        "network_allowlist": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "receipt_ref": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}