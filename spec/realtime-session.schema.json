{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/spec/builder-commons/realtime-session.schema.json",
  "title": "Builder Commons Realtime Collaboration Session",
  "type": "object",
  "required": ["schema_version","session_id","room_ref","status","participants","approved_surfaces"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "session_id": { "type": "string", "minLength": 1 },
    "room_ref": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft","active","paused","ended"] },
    "participants": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "approved_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["surface_id","kind","owner_ref","approved"],
        "properties": {
          "surface_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["screen","window","terminal","browser","app","camera","microphone","spatial","agent-status"] },
          "owner_ref": { "type": "string" },
          "label": { "type": ["string","null"] },
          "approved": { "type": "boolean", "const": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}