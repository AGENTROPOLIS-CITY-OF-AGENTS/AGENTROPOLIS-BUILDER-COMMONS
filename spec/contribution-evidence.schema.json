{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/spec/builder-commons/contribution-evidence.schema.json",
  "title": "Builder Commons Contribution Evidence",
  "type": "object",
  "required": ["schema_version", "evidence_id", "project_id", "contributor_ref", "contribution_type", "evidence"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "evidence_id": { "type": "string" },
    "project_id": { "type": "string" },
    "contributor_ref": { "type": "string" },
    "contribution_type": {
      "type": "string",
      "enum": [
        "code",
        "architecture",
        "design",
        "testing",
        "security",
        "documentation",
        "triage",
        "translation",
        "dataset",
        "model-evaluation",
        "agent-workflow",
        "compute",
        "community",
        "other"
      ]
    },
    "summary": { "type": "string" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string" },
          "ref": { "type": "string" },
          "hash": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["unverified", "verified", "disputed", "rejected"] },
        "verifier_ref": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"], "format": "date-time" },
        "receipt_ref": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}