{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/spec/builder-commons/compute-resource.schema.json",
  "title": "Builder Commons Compute Resource",
  "type": "object",
  "required": [
    "schema_version",
    "resource_id",
    "owner_ref",
    "provider_type",
    "status",
    "capabilities",
    "sandbox",
    "metadata"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "resource_id": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": "string", "minLength": 1 },
    "provider_type": { "type": "string", "enum": ["local", "community", "cloud", "edge"] },
    "status": { "type": "string", "enum": ["offline", "available", "reserved", "busy", "draining"] },
    "capabilities": {
      "type": "object",
      "properties": {
        "cpu": { "type": ["string", "null"] },
        "memory_gb": { "type": ["number", "null"], "minimum": 0 },
        "gpu": { "type": ["string", "null"] },
        "vram_gb": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "policy_ref": { "type": ["string", "null"] },
    "cost_policy_ref": { "type": ["string", "null"] },
    "sandbox": {
      "type": "object",
      "required": ["required", "modes"],
      "properties": {
        "required": { "type": "boolean" },
        "modes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "subscription": {
      "type": ["object", "null"],
      "properties": {
        "status": { "type": "string" },
        "remaining_units": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "cost": {
      "type": ["object", "null"],
      "properties": {
        "hourly_micros": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}