{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.dev/spec/builder-commons/compute-resource.schema.json",
  "title": "Builder Commons Compute Resource",
  "type": "object",
  "required": ["schema_version", "resource_id", "provider_type", "status", "capabilities"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "resource_id": { "type": "string" },
    "provider_type": { "type": "string", "enum": ["local", "community", "cloud", "edge"] },
    "status": { "type": "string", "enum": ["offline", "available", "reserved", "busy", "draining"] },
    "capabilities": {
      "type": "object",
      "properties": {
        "cpu": { "type": ["string", "null"] },
        "memory_gb": { "type": ["number", "null"], "minimum": 0 },
        "gpu": { "type": ["string", "null"] },
        "vram_gb": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "policy_ref": { "type": ["string", "null"] },
    "cost_policy_ref": { "type": ["string", "null"] },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}